<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Clothesline</RootNamespace>
    <AssemblyName>Clothesline</AssemblyName>
    <StartupObject>Clothesline.Program</StartupObject>
    <ApplicationIcon>Clothesline.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Clothesline</AssemblyTitle>
    <Product>Clothesline</Product>
    <Version>0.1.0</Version>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
